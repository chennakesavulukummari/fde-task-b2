# Shared settings for Kubernetes 3-Node EC2 Deployment (1 Control Plane + 2 Workers).
# Values already set in the environment (e.g. CodeBuild env vars) win.
: "${AWS_REGION:=ap-south-2}"            # Asia Pacific (Hyderabad)
: "${APP_NAME:=fde-task-app}"
: "${ARTIFACT_BUCKET:=fde-artifacts}"
: "${UBUNTU_AMI_PARAM:=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}"
: "${K8S_CP_INSTANCE_TYPE:=t3.medium}"
: "${K8S_WORKER_INSTANCE_TYPE:=t3.medium}"
: "${K8S_WORKER_COUNT:=2}"
: "${ROOT_VOLUME_GB:=25}"
: "${K8S_VERSION:=1.31}"
: "${K8S_POD_CIDR:=10.244.0.0/16}"
: "${K8S_NODEPORT:=30080}"
: "${K8S_DB_PASSWORD_PARAM:=/${APP_NAME}/k8s/db-password}"
: "${K8S_DB_ROOT_PASSWORD_PARAM:=/${APP_NAME}/k8s/db-root-password}"
: "${K8S_EC2_ROLE:=${APP_NAME}-k8s-ec2-role}"
: "${K8S_EC2_INSTANCE_PROFILE:=${APP_NAME}-k8s-ec2-profile}"

export AWS_REGION AWS_DEFAULT_REGION="$AWS_REGION" APP_NAME ARTIFACT_BUCKET UBUNTU_AMI_PARAM \
       K8S_CP_INSTANCE_TYPE K8S_WORKER_INSTANCE_TYPE K8S_WORKER_COUNT ROOT_VOLUME_GB \
       K8S_VERSION K8S_POD_CIDR K8S_NODEPORT \
       K8S_DB_PASSWORD_PARAM K8S_DB_ROOT_PASSWORD_PARAM \
       K8S_EC2_ROLE K8S_EC2_INSTANCE_PROFILE

