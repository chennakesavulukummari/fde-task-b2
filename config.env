# Shared settings for every script in this repository.
# Values already set in the environment (e.g. CodeBuild env vars) win.
: "${AWS_REGION:=ap-south-2}"            # Asia Pacific (Hyderabad)
: "${APP_NAME:=fde-task-app}"
: "${ARTIFACT_BUCKET:=fde-artifacts}"
: "${UBUNTU_AMI_PARAM:=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}"
: "${SINGLE_INSTANCE_TYPE:=t3.medium}"
: "${ROOT_VOLUME_GB:=20}"
: "${DB_PASSWORD_PARAM:=/${APP_NAME}/db-password}"
: "${DB_ROOT_PASSWORD_PARAM:=/${APP_NAME}/db-root-password}"
: "${DOCKER_DB_PASSWORD_PARAM:=/${APP_NAME}/docker/db-password}"
: "${DOCKER_DB_ROOT_PASSWORD_PARAM:=/${APP_NAME}/docker/db-root-password}"
: "${EC2_INSTANCE_PROFILE:=${APP_NAME}-ec2-profile}"
: "${DOCKER_EC2_ROLE:=${APP_NAME}-docker-ec2-role}"
: "${DOCKER_EC2_INSTANCE_PROFILE:=${APP_NAME}-docker-ec2-profile}"
export AWS_REGION AWS_DEFAULT_REGION="$AWS_REGION" APP_NAME ARTIFACT_BUCKET UBUNTU_AMI_PARAM \
       SINGLE_INSTANCE_TYPE ROOT_VOLUME_GB DB_PASSWORD_PARAM DB_ROOT_PASSWORD_PARAM \
       DOCKER_DB_PASSWORD_PARAM DOCKER_DB_ROOT_PASSWORD_PARAM EC2_INSTANCE_PROFILE \
       DOCKER_EC2_ROLE DOCKER_EC2_INSTANCE_PROFILE
